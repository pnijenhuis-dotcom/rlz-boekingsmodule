# Kopieer naar .env en pas aan indien nodig. Standaardwaarden verwachten lokale PostgreSQL 16
# (Homebrew, `brew install postgresql@16`) op poort 5433 — zie README.md voor waarom.

DATABASE_URL=postgresql+psycopg://postgres@localhost:5433/boekhouding
APP_DATABASE_URL=postgresql+psycopg://boekhouding_app:devpassword@localhost:5433/boekhouding
TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:5433/boekhouding_test
TEST_APP_DATABASE_URL=postgresql+psycopg://boekhouding_app:devpassword@localhost:5433/boekhouding_test

# Alleen lokale dev: wachtwoord van de least-privilege app-rol die migratie 0001 aanmaakt.
# In Cloud Run komt dit uit Secret Manager, nooit hier.
APP_DB_PASSWORD=devpassword

# Alleen lokale dev: JWT-signing-secret (migratie 0002-auth) en de masterkey (base64, 32 bytes)
# voor envelope-encryptie van totp_secret. Leeg laten = dev-only fallback (zie
# app/security/tokens.py::_resolve_jwt_secret, app/security/envelope.py::_resolve_master_key) —
# buiten dev/local faalt de app hard zonder deze twee expliciet gezet (Cloud Run: Secret Manager).
# JWT_SECRET=
# TOTP_MASTER_KEY=

# GCP-uitrol (draaiboek F1, 2026-08-13) — lokaal ALLEBEI leeg laten (dev draait op
# bestandssysteem + lokale masterkey). In Cloud Run gezet via env/Secret Manager:
# DOCUMENT_GCS_BUCKET      = documentopslag via Cloud Storage i.p.v. lokale schijf
# KMS_MASTERKEY_SLEUTEL    = volledige CryptoKey-resourcenaam; masterkey-wrap via Cloud KMS.
#   ⚠️ pas zetten NA scripts/herversleutel_masterkey.py — anders kluis-zonder-sleutel.
# DOCUMENT_GCS_BUCKET=
# KMS_MASTERKEY_SLEUTEL=

# AI-extractie (fase AI-extractie sessie 1): Claude-API-key voor het extraheren van
# inkoopfactuur-PDF's. Nooit committen (besluit 0012); in Cloud Run via Secret Manager. Zonder
# key wordt AI-extractie zichtbaar overgeslagen (tijdlijn: "geen_api_key") — geen fallback.
# Let op: naast deze key moet ook de AVG-gate per administratie aan staan
# (make ai-extractie-aan, default UIT — zie docs/BOUWPLAN.md over de AVG-volgorde).
# ANTHROPIC_API_KEY=

# GCP F2 (productie — in Cloud Run gezet door .github/workflows/deploy.yml, lokaal niet nodig):
# same-origin frontend-serving (pad naar de Vite-build; het Docker-beeld zet 'm op /app/static)
# FRONTEND_DIST_MAP=
# Cloud SQL instance-connection-name (project:regio:instantie) — de app composeert hiermee
# samen met APP_DB_WACHTWOORD / DB_OWNER_WACHTWOORD (Secret Manager) de database-URL's;
# fail-closed: verbinding zonder wachtwoord weigert te starten (app/config.py).
# CLOUD_SQL_VERBINDING=

# Synthetische bewaking (best-practice-besluit 1, 31-08 — job rlz-bewaking, elk kwartier).
# Lokaal niets zetten: de RLZ-probe wordt dan overgeslagen en alerts gaan (bij ontbrekende
# SMTP-config) alleen naar de log. Productiewaarden staan in deploy.yml.
# BEWAKING_ALERT_ONTVANGER=p.nijenhuis@kempengroep.nl   (code-default; override alleen bewust)
# BEWAKING_RLZ_ADMINISTRATIE_ID=                        (rlz-admin-id van de TEST-administratie)
# BEWAKING_AI_MODEL=claude-haiku-4-5                    (goedkoopste gepinde model, kostenmeter)
# BEWAKING_EXTRACTIE_FOUTRATIO_DREMPEL=0.5              (foutpiek-signaal per uur)
# BEWAKING_EXTRACTIE_MIN_POGINGEN=3
